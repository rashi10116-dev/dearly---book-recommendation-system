# DEARLY Application Configuration Template
# Copy this file to .env or backend/.env and replace placeholders with your actual settings.

# Environment Mode: 'development' or 'production'
ENVIRONMENT=development

# Security & Authentication (minimum 32 characters in production)
SECRET_KEY=your_secure_random_jwt_secret_key_minimum_32_characters

# JWT Algorithm (default: HS256)
ALGORITHM=HS256

# Access Token Expiry in minutes (e.g. 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
# Examples:
#   Local PostgreSQL default:  postgresql+psycopg2://postgres:postgres@localhost:5432/dearly_db
#   Local custom port:         postgresql+psycopg2://postgres@localhost:15432/dearly_db
#   Cloud / Supabase:          postgresql+psycopg2://postgres.xxx:your_password@aws-0-region.pooler.supabase.com:6543/postgres
#   Neon / Neon.tech:          postgresql+psycopg2://username:your_password@ep-sample-123456.us-east-2.aws.neon.tech/neondb
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/dearly_db

# Book Catalog Provider APIs
# Google Books API Key (Optional: Google Books works without a key for standard rate limits; configure a key for higher quota)
GOOGLE_BOOKS_API_KEY=
# Open Library Base URL (Defaults to official API)
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# CORS Allowed Origins (Comma-separated, wildcard '*' strictly forbidden in production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Upload Constraints
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_UPLOAD_ROWS=5000
